# The before-runs are byte-exact reproductions of todo 05's failure logs, kept
# unaltered as evidence. bun:test prints an empty source context line as "193 | "
# with a trailing space, so the whitespace hint is disabled for those retained
# logs instead of rewriting the recorded bytes (same treatment as
# ../task-03/.gitattributes: raw evidence stays raw).
/commands/006-baseline-before-suites-off.stderr.log whitespace=-blank-at-eol
/commands/007-latest-before-suites-off.stderr.log whitespace=-blank-at-eol
