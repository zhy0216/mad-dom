    "source": "from pathlib import Path\nfrom html.parser import HTMLParser\nfrom urllib.parse import unquote,urlparse\nimport hashlib,json,sys\nroot=Path.cwd(); lane=sys.argv[1];dist=root/'docs/.vitepress/dist'\nclass Links(HTMLParser):\n def __init__(self):super().__init__();self.hrefs=[]\n def handle_starttag(self,tag,attrs):\n  if tag=='a':\n   self.hrefs.extend(v for k,v in attrs if k=='href')\nreport=dist/'bun-native-runtime-results.html';performance=dist/'performance.html';memory=dist/'ffi-memory-protocol.html'\npages={p.name:p.read_text() for p in [report,performance,memory]}\nassert 'mad-dom/memory-stability/2' in pages[report.name]\nassert '1194' in pages[report.name]\nlinks=Links();links.feed(pages[report.name]);evidence=[]\nprefix='https://github.com/zhy0216/mad-dom/blob/main/'\nfor href in links.hrefs:\n if href.startswith(prefix+'docs/bun-native-runtime-evidence/'):\n  relative=unquote(urlparse(href).path.split('/blob/main/',1)[1]);assert (root/relative).is_file(),relative\n  evidence.append({'href':href,'source':relative})\n assert not (not urlparse(href).scheme and 'bun-native-runtime-evidence/' in href),href\nassert len(evidence)>=25\nassert 'bun-native-runtime-results.html' in pages[performance.name]\nassert prefix+'docs/ffi-memory-evidence.json' in pages[memory.name]\nassert not (dist/'bun-native-runtime-evidence').exists(), 'Unexpected reliance on local JSON copying'\nrecord={'reportSourceSha256':hashlib.sha256((root/'docs/bun-native-runtime-results.md').read_bytes()).hexdigest(),'htmlSha256':{name:hashlib.sha256(text.encode()).hexdigest() for name,text in pages.items()},'evidenceLinks':evidence,'performancePageLinksReport':True,'existing04EvidenceUsesSourceURL':True,'evidenceJSONCopiedToDist':False,'note':'Source URLs point to files in this checkout; no publication or remote HTTP availability is claimed before integration/push.'}\np=root/'docs/bun-native-runtime-evidence/documentation.json';d=json.loads(p.read_text());d['lanes'][lane]=record;p.write_text(json.dumps(d,indent=2)+'\\n')\nprint(json.dumps({'lane':lane,'evidenceLinks':len(evidence),'pages':list(pages),'checks':'pass'}))\n"
  },
  "reproduction": "From the repository root, run bun run docs:build using the selected Bun, then run the embedded Python verification source with that lane as argv[1]. The source initializes from the existing documentation.json and inspects emitted HTML and source-file targets; it does not assume publication or HTTP availability."
