{
  "name": "mad-dom",
  "version": "0.0.1-alpha.0",
  "description": "A native, memory-arena DOM implementation for Bun.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "js",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "check": "bun --check index.js",
    "test": "bun test tests/bun",
    "validate": "npm run check && cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && npm run compat:types && npm run test && npm run compat:ledger && npm run wpt:test",
    "dev:build": "bash crates/mad-dom-bun/build.sh",
    "test:native": "bun test tests/bun/native.test.js",
    "spike:build": "bash spikes/native-binding/build.sh",
    "spike:test": "bun test spikes/native-binding",
    "spike2:build": "cd spikes/parser-selector-string && cargo build",
    "spike2:test": "cd spikes/parser-selector-string && cargo test",
    "wpt:test": "bun test tests/wpt",
    "wpt:json": "bun tests/wpt/runner.js --json",
    "compat:snapshot": "bun compat/public-api/generate-snapshot.js",
    "compat:snapshot:test": "bun test tests/compat",
    "compat:types": "bun tests/compat/types/run.mjs",
    "compat:differential": "bun tests/compat/runner/run.js --report",
    "compat:differential:selftest": "bun tests/compat/runner/run.js --selftest",
    "compat:ledger": "bun compat/validate-ledger.js",
    "compat:ledger:selftest": "bun compat/validate-ledger.js --self-test",
    "compat:ledger:report": "bun compat/ledger-report.js --json"
  },
  "keywords": [
    "bun",
    "dom",
    "native",
    "html",
    "testing"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "devDependencies": {
    "happy-dom": "20.11.11",
    "typescript": "5.9.3"
  }
}
