{
  "name": "mad-dom",
  "version": "0.0.1-alpha.0",
  "description": "A native, memory-arena DOM implementation for Bun.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "bun",
    "dom",
    "native",
    "html",
    "testing"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  }
}
