{
  "name": "mad-dom",
  "version": "0.0.1-alpha.3",
  "description": "A native, memory-arena DOM implementation for Bun.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "js",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "optionalDependencies": {
    "@mad-dom/platform-darwin-arm64": "0.0.1-alpha.3",
    "@mad-dom/platform-darwin-x64": "0.0.1-alpha.3",
    "@mad-dom/platform-linux-x64-gnu": "0.0.1-alpha.3",
    "@mad-dom/platform-linux-arm64-gnu": "0.0.1-alpha.3",
    "@mad-dom/platform-win32-x64": "0.0.1-alpha.3",
    "@mad-dom/platform-linux-x64-musl": "0.0.1-alpha.3",
    "@mad-dom/platform-linux-arm64-musl": "0.0.1-alpha.3"
  },
  "scripts": {
    "check": "bun --check index.js",
    "test": "bun test tests/bun tests/compat tests/wpt",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "validate": "bun run check && cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && bun run compat:types && bun run test && bun run compat:ledger && bun run compat:hdunit:rewrite && bun run compat:hdunit:validate && bun run wpt:test",
    "dev:build": "bash crates/mad-dom-bun/build.sh",
    "test:native": "bun test tests/bun/native.test.js",
    "platform:build": "bun scripts/build-platform-package.mjs",
    "checksums": "bun scripts/checksums.mjs",
    "release:draft": "bun scripts/release.mjs draft",
    "release:publish": "bun scripts/release.mjs publish",
    "release:rollback": "bun scripts/release-rollback.mjs",
    "smoke:install": "bun scripts/install-smoke.mjs",
    "wpt:test": "bun test tests/wpt",
    "wpt:json": "bun tests/wpt/runner.js --json",
    "test:integration": "bun run --cwd benchmark/mad-dom-integration-test test:ci",
    "bench:integration": "bun benchmark/run.mjs",
    "bench:dom": "bun benchmark/dom-bench/run.mjs",
    "bench:core": "cargo run --release -p mad-dom-core --example bench -- --json",
    "bench:ffi": "bun scripts/bench-ffi-gc.mjs",
    "bench:run": "bun scripts/bench.mjs --report",
    "bench:record": "bun scripts/bench.mjs --record",
    "bench:check": "bun scripts/bench.mjs",
    "compat:snapshot": "bun compat/public-api/generate-snapshot.js",
    "compat:snapshot:test": "bun test tests/compat",
    "compat:types": "bun tests/compat/types/run.mjs",
    "compat:differential": "bun tests/compat/runner/run.js --report",
    "compat:differential:selftest": "bun tests/compat/runner/run.js --selftest",
    "compat:ledger": "bun compat/validate-ledger.js",
    "compat:ledger:selftest": "bun compat/validate-ledger.js --self-test",
    "compat:ledger:report": "bun compat/ledger-report.js --json",
    "compat:hdunit:vendor": "bun scripts/vendor-happy-dom-tests.mjs",
    "compat:hdunit:shim": "bun scripts/generate-happy-dom-shim.mjs",
    "compat:hdunit:rewrite": "bun scripts/rewrite-happy-dom-tests.mjs",
    "compat:hdunit:validate": "bun tests/happy-dom/validate-triage.mjs",
    "compat:hdunit:report": "bun tests/happy-dom/report.mjs",
    "compat:hdunit:report:baseline": "bun tests/happy-dom/report.mjs --record-baseline",
    "compat:hdunit:test": "bun tests/happy-dom/adapter/run-compat-hdunit-test.mjs"
  },
  "keywords": [
    "bun",
    "dom",
    "native",
    "html",
    "testing"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "devDependencies": {
    "express": "^4.20.0",
    "happy-dom": "20.11.11",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4"
  }
}
