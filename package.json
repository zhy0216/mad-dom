{
  "name": "mad-dom",
  "version": "0.0.1-alpha.0",
  "description": "A native, memory-arena DOM implementation for Bun.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "check": "bun --check index.js",
    "test": "bun test tests/bun",
    "validate": "npm run check && cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && npm run test",
    "spike:build": "bash spikes/native-binding/build.sh",
    "spike:test": "bun test spikes/native-binding",
    "spike2:build": "cd spikes/parser-selector-string && cargo build",
    "spike2:test": "cd spikes/parser-selector-string && cargo test",
    "compat:snapshot": "bun compat/public-api/generate-snapshot.js",
    "compat:snapshot:test": "bun test tests/compat"
  },
  "keywords": [
    "bun",
    "dom",
    "native",
    "html",
    "testing"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "devDependencies": {
    "happy-dom": "20.11.11"
  }
}
